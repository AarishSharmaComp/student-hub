# Node 22.13+ required. Run npm run api and npm run dev in separate terminals.
PORT=3001
APP_ORIGIN=http://localhost:8080
DATABASE_PATH=./data/student-hub.sqlite
# Development only: opt in to sample accounts/data. Never enable on a real deployment.
DEMO_MODE=true
# For a clean deployment set DEMO_MODE=false and supply the first administrator.
# ADMIN_USERNAME=registrar
# ADMIN_PASSWORD=replace-with-a-unique-long-password
# Secure cookies are enabled automatically in production (requires HTTPS).
